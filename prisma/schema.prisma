generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  HEADTEACHER
  ACADEMIC_ADMIN
  EXAMS_OFFICER
  TEACHER
  FORM_TUTOR
  STUDENT
  PARENT
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TermStatus {
  DRAFT
  OPEN
  MARKS_REVIEW
  FINALIZED
  PUBLISHED
  CLOSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PROMOTED
  REPEATING
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentStatus {
  DRAFT
  OPEN
  SUBMITTED
  APPROVED
  LOCKED
}

enum ResultStatus {
  PRESENT
  ABSENT
  EXEMPT
  NOT_ENTERED
}

enum ReportStatus {
  DRAFT
  FINALIZED
  PUBLISHED
}

enum ReportPublicationType {
  MID_TERM
  END_OF_TERM
}

enum NotificationType {
  ASSESSMENT_OPENED
  ASSESSMENT_SUBMITTED
  TERM_RESULT_PUBLISHED
  MID_TERM_REPORT_PUBLISHED
  END_OF_TERM_REPORT_PUBLISHED
  END_OF_TERM_REPORT_UNPUBLISHED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  PENDING_PAYMENT
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model School {
  id                       String       @id @default(cuid())
  name                     String
  slug                     String       @unique
  email                    String?
  address                  String?
  phone                    String?
  logoDataUrl              String?      @db.Text
  secondaryLogoDataUrl     String?      @db.Text
  classTeacherSignerName   String?
  headteacherSignerName    String?
  reportDesign             Json           @default("{}")
  status                   SchoolStatus @default(ACTIVE)

  users                User[]
  teachers             Teacher[]
  teacherInvitations   TeacherInvitation[]
  studentAccounts      StudentAccount[]
  parents              Parent[]
  parentStudents       ParentStudent[]
  students             Student[]
  academicYears        AcademicYear[]
  terms                Term[]
  gradeScales          GradeScale[]
  gradeBoundaries      GradeBoundary[]
  classLevels          ClassLevel[]
  classGroups          ClassGroup[]
  subjects             Subject[]
  subjectStreams       SubjectStream[]
  classSubjects        ClassSubject[]
  teachingAssignments  TeachingAssignment[]
  formTutorAssignments FormTutorAssignment[]
  attendanceSessions   AttendanceSession[]
  enrollments          Enrollment[]
  enrollmentSubjectStreams EnrollmentSubjectStream[]
  assessments          Assessment[]
  assessmentResults    AssessmentResult[]
  annualSubjectResults AnnualSubjectResult[]
  auditLogs            AuditLog[]
  promotionBatches     PromotionBatch[]
  subscriptions        SchoolSubscription[]
  promotionPolicies    PromotionPolicy[]
  notifications        Notification[]
  reportPublications   ReportPublication[]
  reportCardDetails    ReportCardDetails[]
  theme SchoolTheme?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolTheme {
  id       String @id @default(cuid())
  schoolId String @unique

  // Brand colors
  primaryColor   String @default("#216b49")
  secondaryColor String @default("#287b59")
  accentColor    String @default("#eaf3ec")

  // Interface colors
  pageBackground String @default("#f4f6f5")
  surfaceColor   String @default("#ffffff")
  textColor      String @default("#1c2821")
  mutedTextColor String @default("#59665e")
  borderColor    String @default("#dfe5e0")

  // Appearance
  mode       String @default("LIGHT")
  fontFamily String @default("Inter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  description   String?
  interval      BillingInterval
  priceMinor    Int
  currency      String               @default("MWK")
  trialDays     Int                  @default(14)
  maxStudents   Int?
  maxStaff      Int?
  isActive      Boolean              @default(true)
  subscriptions SchoolSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priceMinor])
}

model SchoolSubscription {
  id                 String             @id @default(cuid())
  schoolId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  notes              String?

  school School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status, currentPeriodEnd])
  @@index([planId, status])
}

// ============================================================
// USERS AND ACCESS
// ============================================================

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  passwordHash String
  firstName    String
  lastName     String
  signatureDataUrl String?      @db.Text
  role         UserRole     @default(TEACHER)
  status       RecordStatus @default(ACTIVE)
  schoolId     String?

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  teacher        Teacher?
  studentAccount StudentAccount?
  parents        Parent[]

  enteredResults AssessmentResult[] @relation("ResultEnteredBy")
  auditLogs      AuditLog[]         @relation("AuditActor")

  promotionBatchesCreated  PromotionBatch[] @relation("PromotionBatchCreatedBy")
  promotionBatchesApproved PromotionBatch[] @relation("PromotionBatchApprovedBy")
  notifications             Notification[]
  attendanceSessions        AttendanceSession[]
  passwordResetTokens       PasswordResetToken[]
  publishedReports          ReportPublication[] @relation("ReportPublisher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
  @@index([lastName, firstName])
  @@index([schoolId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Teacher {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  staffNumber String?
  userId      String? @unique
  schoolId    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  user        User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments TeachingAssignment[]
  formTutorAssignments FormTutorAssignment[]
  invitations TeacherInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, staffNumber])
  @@index([lastName, firstName])
  @@index([schoolId])
}

model TeacherInvitation {
  id          String    @id @default(cuid())
  teacherId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  schoolId    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
  @@index([expiresAt])
  @@index([schoolId])
}

model StudentAccount {
  id        String @id @default(cuid())
  userId    String @unique
  studentId String @unique
  schoolId  String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Parent {
  id        String  @id @default(cuid())
  userId    String?
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  schoolId  String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  user     User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  students ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, email])
  @@index([userId])
  @@index([schoolId, phone])
  @@index([schoolId])
}

model ParentStudent {
  id           String  @id @default(cuid())
  parentId     String
  studentId    String
  relationship String?
  isPrimary    Boolean @default(false)
  schoolId     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([schoolId])
}

// ============================================================
// STUDENTS
// ============================================================

model Student {
  id              String       @id @default(cuid())
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  dateOfBirth     DateTime?    @db.Date
  gender          String?
  status          RecordStatus @default(ACTIVE)
  schoolId        String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  account       StudentAccount?
  parents       ParentStudent[]
  enrollments   Enrollment[]
  annualResults AnnualSubjectResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNumber])
  @@index([lastName, firstName])
  @@index([status])
  @@index([schoolId])
}

// ============================================================
// ACADEMIC YEARS, TERMS AND GRADING
// ============================================================

model AcademicYear {
  id           String   @id @default(cuid())
  name         String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  isCurrent    Boolean  @default(false)
  schoolId     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  terms         Term[]
  formTutorAssignments FormTutorAssignment[]
  annualResults AnnualSubjectResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([isCurrent])
  @@index([schoolId])
}

model Term {
  id                  String     @id @default(cuid())
  name                String
  sequence            Int
  academicYearId      String
  startDate           DateTime   @db.Date
  endDate             DateTime   @db.Date
  annualWeightPercent Decimal?   @db.Decimal(5, 2)
  status              TermStatus @default(DRAFT)
  schoolId            String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  enrollments Enrollment[]
  assignments TeachingAssignment[]
  attendanceSessions AttendanceSession[]
  subjectStreams SubjectStream[]
  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotionBatchesFrom PromotionBatch[] @relation("PromotionBatchSourceTerm")
  promotionBatchesTo   PromotionBatch[] @relation("PromotionBatchDestinationTerm")
  reportPublications   ReportPublication[]

  @@unique([academicYearId, sequence])
  @@unique([academicYearId, name])
  @@index([status])
  @@index([schoolId])
}

model GradeScale {
  id          String  @id @default(cuid())
  name        String
  description String?
  maxScore    Int     @default(100)
  schoolId    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  boundaries    GradeBoundary[]
  classLevels   ClassLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model GradeBoundary {
  id           String  @id @default(cuid())
  gradeScaleId String
  grade        String
  minPercent   Decimal @db.Decimal(5, 2)
  description  String?
  schoolId     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)

  @@unique([gradeScaleId, grade])
  @@unique([gradeScaleId, minPercent])
  @@index([gradeScaleId, minPercent])
  @@index([schoolId])
}

// ============================================================
// CLASSES AND SUBJECTS
// ============================================================

model ClassLevel {
  id          String  @id @default(cuid())
  name        String
  levelOrder  Int
  nextLevelId String?
  gradeScaleId String?
  schoolId    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  nextLevel      ClassLevel?  @relation("ClassProgression", fields: [nextLevelId], references: [id], onDelete: SetNull)
  previousLevels ClassLevel[] @relation("ClassProgression")
  gradeScale     GradeScale?  @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)

  groups            ClassGroup[]
  enrollments       Enrollment[]
  subjects          ClassSubject[]
  subjectStreams    SubjectStream[]
  promotionPolicies PromotionPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, levelOrder])
  @@index([gradeScaleId])
  @@index([schoolId])
}

model ClassGroup {
  id           String @id @default(cuid())
  name         String
  classLevelId String
  schoolId     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classLevel       ClassLevel           @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  enrollments      Enrollment[]
  assignments      TeachingAssignment[]
  formTutorAssignments FormTutorAssignment[]
  attendanceSessions AttendanceSession[]
  promotionBatches PromotionBatch[]
  reportPublications ReportPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classLevelId, name])
  @@index([classLevelId])
  @@index([schoolId])
}

model ReportPublication {
  id            String               @id @default(cuid())
  type          ReportPublicationType
  termId        String
  classGroupId  String
  schoolId      String
  publishedById String
  publishedAt   DateTime             @default(now())

  term        Term      @relation(fields: [termId], references: [id], onDelete: Restrict)
  classGroup  ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  publishedBy User      @relation("ReportPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([termId, classGroupId, type])
  @@index([schoolId, type, publishedAt])
}

model Subject {
  id       String       @id @default(cuid())
  code     String
  name     String
  status   RecordStatus @default(ACTIVE)
  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classLinks    ClassSubject[]
  teachingAssignments TeachingAssignment[]
  subjectStreams SubjectStream[]
  assessments   Assessment[]
  annualResults AnnualSubjectResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([status])
  @@index([schoolId])
}

model ClassSubject {
  id           String @id @default(cuid())
  classLevelId String
  subjectId    String
  isRequired   Boolean @default(true)
  schoolId     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  assignments TeachingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classLevelId, subjectId])
  @@index([subjectId])
  @@index([schoolId])
}

model SubjectStream {
  id           String       @id @default(cuid())
  name         String
  classLevelId String
  subjectId    String
  termId       String
  schoolId     String
  status       RecordStatus @default(ACTIVE)

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  term       Term       @relation(fields: [termId], references: [id], onDelete: Restrict)

  teachingAssignments TeachingAssignment[]
  studentSelections EnrollmentSubjectStream[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classLevelId, termId, subjectId, name])
  @@index([classLevelId, termId])
  @@index([subjectId, termId])
  @@index([schoolId])
}

// ============================================================
// TEACHER ASSIGNMENTS
// ============================================================

model TeachingAssignment {
  id             String @id @default(cuid())
  teacherId      String
  classGroupId   String?
  subjectId      String
  classSubjectId String?
  subjectStreamId String?
  termId         String
  schoolId       String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classGroup   ClassGroup?  @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classSubject ClassSubject? @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  subjectStream SubjectStream? @relation(fields: [subjectStreamId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, termId])
  @@index([classGroupId, termId])
  @@index([subjectId, termId])
  @@index([classSubjectId, termId])
  @@index([subjectStreamId])
  @@index([schoolId])
}

model FormTutorAssignment {
  id             String @id @default(cuid())
  teacherId      String
  classGroupId   String
  academicYearId String
  schoolId       String

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classGroupId, academicYearId])
  @@index([teacherId, academicYearId])
  @@index([schoolId])
}

model AttendanceSession {
  id           String   @id @default(cuid())
  classGroupId String
  termId       String
  date         DateTime @db.Date
  takenById    String
  schoolId     String

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classGroup ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  term       Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  takenBy    User         @relation(fields: [takenById], references: [id], onDelete: Restrict)
  records    AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classGroupId, termId, date])
  @@index([termId, date])
  @@index([schoolId])
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  attendanceSessionId String
  enrollmentId        String
  status              AttendanceStatus
  note                String?

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, enrollmentId])
  @@index([enrollmentId])
}

// ============================================================
// STUDENT ENROLMENTS AND PROGRESSION
// ============================================================

model Enrollment {
  id                   String           @id @default(cuid())
  studentId            String
  termId               String
  classLevelId         String
  classGroupId         String?
  status               EnrollmentStatus @default(ACTIVE)
  previousEnrollmentId String?          @unique
  schoolId             String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term       Term       @relation(fields: [termId], references: [id], onDelete: Restrict)
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: Restrict)

  previousEnrollment Enrollment? @relation("EnrollmentProgression", fields: [previousEnrollmentId], references: [id], onDelete: Restrict)
  nextEnrollment     Enrollment? @relation("EnrollmentProgression")

  results     AssessmentResult[]
  subjectStreams EnrollmentSubjectStream[]
  attendanceRecords AttendanceRecord[]
  reportCardDetails ReportCardDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([classLevelId, termId, status])
  @@index([classGroupId, termId, status])
  @@index([studentId, status])
  @@index([termId, status])
  @@index([schoolId])
}

model ReportCardDetails {
  id                    String               @id @default(cuid())
  enrollmentId          String
  schoolId              String
  reportType            ReportPublicationType
  behaviorComments      Json                 @default("{}")
  coCurricularComments  Json                 @default("{}")
  promotedTo            String?
  promotionRemarks      String?              @db.Text
  enrollment            Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  school                School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([enrollmentId, reportType])
  @@index([schoolId, reportType])
}

model EnrollmentSubjectStream {
  id             String       @id @default(cuid())
  enrollmentId   String
  subjectStreamId String
  status               RecordStatus @default(ACTIVE)
  droppedAt            DateTime?
  schoolId             String

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  subjectStream SubjectStream @relation(fields: [subjectStreamId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, subjectStreamId])
  @@index([subjectStreamId, status])
  @@index([schoolId])
}

// ============================================================
// ASSESSMENTS AND MARK ENTRY
// ============================================================

model Assessment {
  id                   String           @id @default(cuid())
  title                String
  assessmentType       String
  assessmentDate       DateTime?         @db.Date
  maxMark              Decimal          @db.Decimal(7, 2)
  termId               String
  subjectId            String
  teachingAssignmentId String
  status               AssessmentStatus @default(DRAFT)
  schoolId             String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  term               Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)

  results AssessmentResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId, subjectId, status])
  @@index([teachingAssignmentId])
  @@index([schoolId])
}

model AssessmentResult {
  id             String       @id @default(cuid())
  assessmentId   String
  enrollmentId   String
  mark           Decimal?     @db.Decimal(7, 2)
  status         ResultStatus @default(NOT_ENTERED)
  teacherComment String?
  enteredById    String?
  enteredAt      DateTime?
  schoolId       String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  enteredBy  User?      @relation("ResultEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
  @@index([enteredById])
  @@index([schoolId])
}

// ============================================================
// ANNUAL SUBJECT RESULTS
// ============================================================

model AnnualSubjectResult {
  id               String       @id @default(cuid())
  studentId        String
  academicYearId   String
  subjectId        String
  finalMark        Decimal?     @db.Decimal(5, 2)
  grade            String?
  gradeDescription String?
  status           ReportStatus @default(DRAFT)
  schoolId         String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  calculatedAt DateTime?
  finalizedAt  DateTime?
  publishedAt  DateTime?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId, subjectId])
  @@index([academicYearId, subjectId, status])
  @@index([studentId, academicYearId])
  @@index([schoolId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  schoolId   String?

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([schoolId])
}

model PromotionBatch {
  id                String @id @default(cuid())
  sourceTermId      String
  destinationTermId String
  classGroupId      String
  schoolId          String

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  status    String @default("APPROVED")
  decisions Json

  createdById  String
  approvedById String
  approvedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceTerm      Term       @relation("PromotionBatchSourceTerm", fields: [sourceTermId], references: [id], onDelete: Restrict)
  destinationTerm Term       @relation("PromotionBatchDestinationTerm", fields: [destinationTermId], references: [id], onDelete: Restrict)
  classGroup      ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  createdBy       User       @relation("PromotionBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User       @relation("PromotionBatchApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([sourceTermId, classGroupId])
  @@index([destinationTermId])
  @@index([approvedById, approvedAt])
  @@index([schoolId])
}

model PromotionPolicy {
  id                    String     @id @default(cuid())
  schoolId              String
  classLevelId          String
  minimumAverage        Decimal    @default(50) @db.Decimal(5, 2)
  passMark              Decimal    @default(50) @db.Decimal(5, 2)
  minimumSubjectsPassed Int        @default(0)
  requiredSubjectIds    String[]   @default([])
  school                School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classLevel            ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([schoolId, classLevelId])
  @@index([schoolId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  schoolId  String
  type      NotificationType
  title     String
  message   String           @db.VarChar(500)
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId, schoolId, readAt, createdAt])
  @@index([schoolId, createdAt])
}

model ParentPortalVerification {
  id             String    @id @default(cuid())
  identifierHash String
  codeHash       String
  expiresAt      DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([identifierHash, createdAt])
  @@index([expiresAt])
}
