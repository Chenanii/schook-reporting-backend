NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Replace credentials for your local PostgreSQL instance.
DATABASE_URL="postgresql://school_app:change_me@localhost:5432/school_reporting?schema=public"

# Generate a long random secret before enabling JWT authentication.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=8h

# Comma-separated frontend origins, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# SMTP settings used for account emails and weekly term-expiry reminders.
# Leave blank to disable email delivery; reminders remain visible in the app.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# TextBee device for parent phone verification (keep these values private).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_DEFAULT_COUNTRY_CODE=265

# PayChangu Standard Checkout. Start with test credentials; switch to live only after verification.
PAYCHANGU_MODE=test
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
# In local testing, use a public HTTPS tunnel for PayChangu callbacks and webhooks.
# Production requires publicly reachable HTTPS URLs; localhost will not receive provider traffic.
PAYCHANGU_CALLBACK_URL=http://localhost:4000/api/v1/subscriptions/paychangu/callback
PAYCHANGU_RETURN_URL=http://localhost:5173/subscriptions
