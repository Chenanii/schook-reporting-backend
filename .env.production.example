# Docker Hub and domain
DOCKERHUB_USERNAME=chenanii
DOMAIN=api.nexaschools.dimtmw.com

# PostgreSQL data is kept in the postgres_data Docker volume.
POSTGRES_DB=school_reporting
POSTGRES_USER=school_app
# Use an alphanumeric secret, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Backend secrets and public URLs
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://school.example.com
APP_NAME=School Reporting System
TEACHER_INVITATION_BASE_URL=https://school.example.com/accept-invitation
PASSWORD_RESET_BASE_URL=https://school.example.com/reset-password

# Payment provider URLs must be publicly reachable HTTPS URLs in production.
PAYCHANGU_MODE=test
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_CALLBACK_URL=https://school.example.com/api/v1/subscriptions/paychangu/callback
PAYCHANGU_RETURN_URL=https://school.example.com/subscriptions

# Optional email settings
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@school.example.com

# Optional parent verification SMS settings
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_DEFAULT_COUNTRY_CODE=265
